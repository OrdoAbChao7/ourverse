# ─── OURVERSE environment ────────────────────────────────────────────────
# Copy to `.env.local` for development. NEVER commit real credentials.
#
# Backend selection:
#   local    → fully offline demo repository (IndexedDB). No account needed.
#   supabase → real Supabase project (requires the two values below).
#
# The app defaults to `local` when these are absent, and labels demo data
# explicitly in the UI. A local Supabase stack is used to verify real
# RLS/Auth/Storage; cloud deployment and hosted acceptance remain BLOCKED
# until a real Supabase project and explicit authorization are provided.

VITE_BACKEND=local

# Public client credentials for a real Supabase project.
# The anon key is safe for the browser by design; row-level security enforces access.
# The service_role key must NEVER be used in the browser or committed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: server-side AI proxy (Supabase Edge Function `ai-ask`).
# The model API key lives in the Edge Function secrets, never in Vite env vars.
# Set to `true` only after deploying the function and enabling AI in Settings.
VITE_AI_PROXY_ENABLED=false

# Build metadata (optional)
VITE_APP_VERSION=0.1.0
